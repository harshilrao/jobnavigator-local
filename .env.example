# JobNavigator Local — runtime configuration
# Copy this file to .env and fill in real secrets. Never commit .env.
# Only the backend reads secrets.

NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Option B (chosen): MongoDB Atlas Free — NEW isolated database named jobnavigator_local.
# Replace with your own Atlas connection string in .env (never commit real credentials).
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/jobnavigator_local?retryWrites=true&w=majority
MONGODB_DB_NAME=jobnavigator_local

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_PROVIDER=ollama

# Optional Free Claude Code proxy — disabled by default
FCC_PROXY_ENABLED=false
FCC_BASE_URL=http://127.0.0.1:8082/v1
FCC_MODEL=
FCC_API_KEY=

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET

UPLOAD_MAX_BYTES=10485760
SCRAPE_CONCURRENCY=2

TELEGRAM_BOT_TOKEN=
